#!/bin/bash -l
#$ -N summarize_models
#$ -P dietzelab
#$ -l h_rt=06:00:00
#$ -pe omp 4
#$ -l mem_per_core=8G
#$ -j y
#$ -o /projectnb/dietzelab/zrwerbin/microbialForecasts/logs/hpc/03_summarize/$JOB_ID.log

# Step 03: Summarize model outputs (parameter summaries, convergence diagnostics)
# Single multi-core job processing all models.
#
# Submit: qsub submit_03_summarize.qsub

module load R/4.4.0
export R_LIBS_USER="/projectnb/dietzelab/zrwerbin/microbialForecasts/R_library"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

PROJECT=/projectnb/dietzelab/zrwerbin/microbialForecasts
mkdir -p "$PROJECT/logs/hpc/03_summarize"

cd "$PROJECT/analysis/model_analysis"
echo "=== Step 03: Summarize model outputs ==="
echo "Timestamp: $(date)"
echo "Cores: $NSLOTS"

Rscript 03_summarizeModelOutputs.r

echo "Exit code: $?"
echo "Completed: $(date)"
