#!/bin/bash -l
#$ -N phenophase
#$ -P dietzelab
#$ -l h_rt=02:00:00
#$ -pe omp 1
#$ -l mem_per_core=8G
#$ -j y
#$ -o /projectnb/dietzelab/zrwerbin/microbialForecasts/logs/hpc/09_pheno/$JOB_ID.log

# Step 09: Assign peak phenophases
# Runs in parallel with steps 08 and 10 after step 07.
# NOTE: Runs from project root (not analysis/model_analysis).
#
# Submit: qsub -hold_jid tidy_hindcasts submit_09_phenophase.qsub

module load R/4.4.0
export R_LIBS_USER="/projectnb/dietzelab/zrwerbin/microbialForecasts/R_library"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

PROJECT=/projectnb/dietzelab/zrwerbin/microbialForecasts
mkdir -p "$PROJECT/logs/hpc/09_pheno"

cd "$PROJECT"
echo "=== Step 09: Assign phenophases ==="
echo "Timestamp: $(date)"

Rscript analysis/model_analysis/09_assignPeakPhenophase.r

echo "Exit code: $?"
echo "Completed: $(date)"
