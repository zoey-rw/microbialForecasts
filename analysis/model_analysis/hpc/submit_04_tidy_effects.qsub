#!/bin/bash -l
#$ -N tidy_effects
#$ -P dietzelab
#$ -l h_rt=01:00:00
#$ -pe omp 1
#$ -l mem_per_core=8G
#$ -j y
#$ -o /projectnb/dietzelab/zrwerbin/microbialForecasts/logs/hpc/04_tidy/$JOB_ID.log

# Step 04: Tidy effect sizes (extract predictor effects, site effects, seasonality)
# Fast data transformation, no parallelism needed.
#
# Submit: qsub -hold_jid summarize_models submit_04_tidy_effects.qsub

module load R/4.4.0
export R_LIBS_USER="/projectnb/dietzelab/zrwerbin/microbialForecasts/R_library"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

PROJECT=/projectnb/dietzelab/zrwerbin/microbialForecasts
mkdir -p "$PROJECT/logs/hpc/04_tidy"

cd "$PROJECT/analysis/model_analysis"
echo "=== Step 04: Tidy effect sizes ==="
echo "Timestamp: $(date)"

Rscript 04_tidyEffectSizes.r

echo "Exit code: $?"
echo "Completed: $(date)"
